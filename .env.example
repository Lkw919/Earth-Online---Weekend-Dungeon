# 高德地图 Web 服务 API Key，注册地址 https://lbs.amap.com/
# 留空时系统会自动退回到 Mock 数据，Demo 同样可演示
AMAP_API_KEY=

# 高德 Web端(JS API) Key + 安全密钥（控制台 → Web端(JS API)）
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=

# 可选：默认城市，未填写时由 agent2 主动询问用户
DEFAULT_CITY=
DEFAULT_DISTRICT=

# 可选：演示模式固定种子；同一输入的人均、排队、价格推断保持稳定
DEMO_SEED=42

# 阿里云百炼 DashScope（OpenAI 兼容模式）
# 注册地址 https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
